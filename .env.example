# Local API proxy used by npm run dev and npm run preview.
API_PROXY_TARGET=http://127.0.0.1:3000
FRONTEND_PORT=5173

# Browser API base path. Keep this relative when using the local proxy.
VITE_API_BASE_URL=/api/v1
# For a separately hosted API, use its public API URL instead:
# VITE_API_BASE_URL=https://your-api.example.com/api/v1
# Never put secrets in VITE_ variables; they are included in the browser build.
