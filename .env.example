NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/mu-metro.db
# Generate using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
HOLD_MINUTES=10
# Explicit opt-in. Demo confirmations never charge money or issue real cinema tickets.
DEMO_PAYMENTS=true
# Set only when running db:seed to create your first administrator. No default login.
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=use-a-unique-password-at-least-12-characters
